[Unit]
Description=invisible_dots desktop: Xvfb on :0 with a minimal XFCE session
After=systemd-user-sessions.service network.target
RequiresMountsFor=/opt/invisible-dots

[Service]
Type=simple
User=dot
Group=dot
WorkingDirectory=/home/dot
Environment=HOME=/home/dot
Environment=DISPLAY=:0
Environment=DOT_SCREEN=1920x1080x24
Environment=PATH=/home/dot/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/invisible-dots/bin/dot-desktop
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=15
